public:
  titre: Transport du public
  unité: kgCO2e
  valeur:
    somme:
      - voiture
      - avion
      - train
      - commun

public . accessible en transports en commun:
  titre: Accessibilité en transports en commun
  par défaut: non
  meta:
    question: Votre festival est-il facilement accessible en transport en commun ?

public . nombre de déplacements:
  note: |
    On considère ici les festivaliers mais aussi les équipes d'organisation et les bénévoles.
  valeur:
    somme:
      - festivaliers
      - bénévoles

public . nombre de déplacements . festivaliers:
  valeur:
    variations:
      - si: hébergement . public présent
        alors:
          hébergement . public . nombre de festivaliers journée + hébergement .
          public . nombre de festivaliers hébergés / informations . nombre de
          jours * 1 jour
      - sinon: informations . nombre de festivaliers

public . nombre de déplacements . bénévoles:
  valeur:
    variations:
      - si: hébergement . bénévoles . type = 'aucun'
        alors:
          informations . nombre de bénévoles * informations . nombre de jours / 1
          jour
      - sinon: informations . nombre de bénévoles

public . distance AR:
  titre: Distance moyenne aller/retour parcourue par un festivalier (hors avion)
  unité: km
  plancher: 0
  par défaut: 100
  note: On inclut ici les festivaliers mais également les bénévoles et les
    organisateurs.
  meta:
    question: Quelle est la distane moyenne aller/retour parcourue par un festivalier ?

public . parts totales:
  titre: 'Vérifiez que total est à 100% :'
  valeur:
    somme:
      - voiture . part
      - avion . part
      - train . part
      - commun . part
      - mobilité douce . part
  meta:
    question:
      Avez-vous bien vérifier que la somme des parts de transport est bien à
      100% ?

public . mobilité douce:
public . mobilité douce . part:
  titre: Part des festivaliers venant à pied ou à vélo
  plancher: 0
  plafond: 100
  unité: '%'
  par défaut:
    variations:
      - si: accessible en transports en commun
        alors: 7
      - sinon: 2
  note: On considère que l'impact de la marche ou du vélo est négligeable.
  meta:
    question: Quelle part des festivaliers viennent à pied ou à vélo ?

public . parts totales modes de transport:
  plafond: 100
  unité: '%'
  valeur:
    somme:
      - voiture . part
      - avion . part
      - train . part
      - commun . part

public . voiture . part:
  titre: Part des festivaliers venant en voiture
  plancher: 0
  plafond: 100
  unité: '%'
  par défaut:
    variations:
      - si: accessible en transports en commun
        alors: 20
      - sinon: 80
  meta:
    question: Quelle part des festivaliers viennent en voiture ?

public . avion . part:
  titre: Part des festivaliers venant en avion
  plancher: 0
  plafond: 100
  unité: '%'
  par défaut:
    variations:
      - si: accessible en transports en commun
        alors: 3
      - sinon: 3
  meta:
    question: Quelle part des festivaliers viennent en avion ?

public . train . part:
  titre: Part des festivaliers venant en train
  plancher: 0
  plafond: 100
  unité: '%'
  par défaut:
    variations:
      - si: accessible en transports en commun
        alors: 20
      - sinon: 10
  meta:
    question: Quelle part des festivaliers viennent en train ?

public . commun . part:
  titre: Part des festivaliers venant en transports en commun
  plancher: 0
  plafond: 100
  unité: '%'
  par défaut:
    variations:
      - si: accessible en transports en commun
        alors: 50
      - sinon: 5
  meta:
    question:
      Quelle part des festivaliers viennent en transports en commun (bus,
      tramway, métro) ?

public . voiture:
  unité: kgCO2e
  note: On fait l'hypothèse d'un aller/retour par festivalier.
  valeur:
    part * nombre de déplacements * distance AR * voiture . empreinte par km
    / voiture . remplissage moyen

public . avion:
  unité: kgCO2e
  valeur: part * nombre de déplacements * distance avion AR * avion . empreinte par km

public . avion . distance avion AR:
  unité: km
  valeur: 1500

public . train:
  unité: kgCO2e
  valeur: part * nombre de déplacements * distance AR * train . empreinte par km

public . commun:
  unité: kgCO2e
  valeur: part * nombre de déplacements * distance AR * commun . empreinte par km
