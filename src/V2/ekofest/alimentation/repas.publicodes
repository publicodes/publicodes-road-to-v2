# importer!:
#   depuis:
#     nom: "@incubateur-ademe/nosgestesclimat"
#   les règles:
#     - alimentation . plats . végétalien . empreinte
#     - alimentation . plats . végétarien . empreinte
#     - alimentation . plats . viande blanche . empreinte
#     - alimentation . plats . viande rouge . empreinte
#     # - alimentation . plats . poisson 1 . empreinte
#     # - alimentation . plats . poisson 2 . empreinte

repas:
  titre: Repas
  valeur:
    somme:
      - végétalien
      - végétarien
      - viande blanche
      - viande rouge
      # - poisson 1
      # - poisson 2

repas . végétalien:
  valeur: nombre * nosgestesclimat . alimentation . plats . végétalien . empreinte

repas . végétalien . nombre:
  valeur: proportion * informations . nombre de repas total

repas . végétalien . proportion:
  valeur:
    variations:
      - si: proposition = 'végétalien'
        alors: 100%
      - sinon: 0%

repas . végétarien:
  valeur: nombre * nosgestesclimat . alimentation . plats . végétarien . empreinte

repas . végétarien . nombre:
  valeur: proportion * informations . nombre de repas total

repas . végétarien . proportion:
  valeur:
    variations:
      - si: proposition = 'végétarien'
        alors: 100%
      - si: proposition = 'mixte végé viande'
        alors: proposition . mixte végé viande . proportion végétarien
      - sinon: 0%

repas . viande blanche:
  valeur: nombre * nosgestesclimat . alimentation . plats . viande blanche . empreinte

repas . viande blanche . nombre:
  valeur: proportion * informations . nombre de repas total

repas . viande blanche . proportion:
  valeur:
    variations:
      - si: proposition = 'viande uniquement'
        alors: proposition . choix viande . proportion viande blanche
      - si: proposition = 'mixte végé viande'
        alors:
          proposition . choix viande . proportion viande blanche * proposition .
          mixte végé viande . proportion viande
      - sinon: 0%

repas . viande rouge:
  valeur: nombre * nosgestesclimat . alimentation . plats . viande rouge . empreinte

repas . viande rouge . nombre:
  valeur: proportion * informations . nombre de repas total

repas . viande rouge . proportion:
  valeur:
    variations:
      - si: proposition = 'viande uniquement'
        alors: proposition . choix viande . proportion viande rouge
      - si: proposition = 'mixte végé viande'
        alors:
          proposition . choix viande . proportion viande rouge * proposition .
          mixte végé viande . proportion viande
      - sinon: 0%

repas . proposition:
  titre: Régime des repas proposés
  type:
    une possibilité:
      - 'végétalien'
      - 'végétarien'
      - 'mixte végé viande'
      - 'viande uniquement'
  par défaut: 'mixte végé viande'
  meta:
    question: Quelle type de régime alimentaire prévoyez-vous ?

repas . proposition . végétalien:
  titre: Uniquement végan

repas . proposition . végétarien:
  titre: Uniquement végétarien

repas . proposition . mixte végé viande:
  titre: Mixte végétarien / viande

repas . proposition . viande uniquement:
  titre: Uniquement carné

repas . proposition . mixte végé viande . proportion végétarien:
  applicable si: proposition = 'mixte végé viande'
  titre: Proportion de repas végétariens
  plancher: 0
  plafond: 100
  par défaut: 50%
  unité: '%'
  meta:
    question: Comment allez-vous répartir les régimes proposés ?

repas . proposition . mixte végé viande . proportion viande:
  applicable si: proposition = 'mixte végé viande'
  unité: '%'
  valeur: 100% - proportion végétarien

repas . proposition . choix viande:
  applicable si:
    une de ces conditions:
      - proposition = 'mixte végé viande'
      - proposition = 'viande uniquement'
  titre: Choix de viande
  type:
    une possibilité:
      - 'viande blanche'
      - 'viande rouge'
      - 'les deux'
  par défaut: 'les deux'
  meta:
    question: Proposerez-vous de la viande blanche ou viande rouge ?

repas . proposition . choix viande . viande blanche:
  titre: Viande blanche
repas . proposition . choix viande . viande rouge:
  titre: Viande rouge
repas . proposition . choix viande . les deux:
  titre: Les 2

repas . proposition . choix viande . proportion viande blanche:
  valeur:
    variations:
      - si: choix viande = 'viande blanche'
        alors: 100%
      - si: choix viande = 'les deux'
        alors: 50%
      - sinon: 0%

repas . proposition . choix viande . proportion viande rouge:
  valeur:
    variations:
      - si: choix viande = 'viande rouge'
        alors: 100%
      - si: choix viande = 'les deux'
        alors: 50%
      - sinon: 0%
