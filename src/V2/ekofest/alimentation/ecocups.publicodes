ecocups:
  titre: Ecocups
  applicable si: ecocups présent
  unité: kgCO2e
  valeur: 1 ecocup.jour * informations . nombre de personnes par jour * empreinte
    / amortissement

ecocups présent:
  titre: Utilisation d'ecocups
  par défaut: oui
  meta:
    question: Allez-vous utiliser des ecocups pour l'événement ?

ecocups . réutilisation:
  titre: Réutilisation des ecocups
  par défaut: non
  meta:
    question: Est-il prévu de réutiliser les ecocups pour une autre édition ?

ecocups . amortissement:
  note: On considère que les ecocups servirons sur 3 éditions.
  valeur:
    variations:
      - si: ecocups . réutilisation
        alors: 3
      - sinon: 1

ecocups . empreinte:
  unité: kgCO2e/ecocup
  valeur: poids * déchets . empreinte plastique par kg

ecocups . poids:
  unité: kg/ecocup
  valeur: 0.030
