fichier:
  formule:
    variations:
      - si: fichier . taille > 0 Go
        alors:
          somme:
            - fichier . terminaux
            - fichier . transmission
            - fichier . data center
      - sinon: 0 gCO2e
  unité: gCO2e

fichier . taille:
  titre: Taille du fichier
  question: Quelle est la taille du fichier en Go ?
  par défaut: 1
  unité: Go

fichier . appareil:
  titre: Appareil utilisé
  question: Quel appareil utilisez-vous ?
  avec:
    ordinateur et écran:
      titre: Ordinateur fixe et écran
    ordinateur portable:
      titre: Ordinateur portable
    tablette:
      titre: Tablette
    smartphone:
      titre: Smartphone
    moyenne:
      titre: Mix moyen d'appareils
  une possibilité:
    - ordinateur et écran
    - ordinateur portable
    - tablette
    - smartphone
    - moyenne
  par défaut: "'moyenne'"

fichier . appareil . moyenne utilisation ordinateur et écran:
  formule: 24%

fichier . appareil . moyenne utilisation ordinateur portable:
  formule: 24%

fichier . appareil . moyenne utilisation tablette:
  formule: 8%

fichier . appareil . moyenne utilisation smartphone:
  formule: 45%

fichier . réseau:
  titre: Type de réseau utilisé
  question: Utilisez-vous le réseau fixe ou mobile ?
  avec:
    fixe:
      titre: Réseau fixe
    mobile:
      titre: Réseau mobile
  une possibilité:
    - fixe
    - mobile
  par défaut: "'mobile'"

fichier . appareil . durée totale sollicitation:
  formule: taille / transmission par défaut . débit
  contexte:
    transmission par défaut . réseau par défaut: fichier . réseau
  unité: h

fichier . terminaux:
  formule:
    somme:
      - construction
      - usage
  unité: gCO2e

fichier . terminaux . construction:
  valeur: construction réelle
  contexte:
    appareil par défaut: fichier . appareil
    durée en heure par défaut: fichier . appareil . durée totale sollicitation
    moyenne utilisation ordinateur et écran par défaut: fichier . appareil . moyenne utilisation ordinateur et écran
    moyenne utilisation ordinateur portable par défaut: fichier . appareil . moyenne utilisation ordinateur portable
    moyenne utilisation tablette par défaut: fichier . appareil . moyenne utilisation tablette
    moyenne utilisation smartphone par défaut: fichier . appareil . moyenne utilisation smartphone
  unité: gCO2e

fichier . terminaux . usage:
  valeur: usage réel
  contexte:
    appareil par défaut: fichier . appareil
    durée en heure par défaut: fichier . appareil . durée totale sollicitation
    moyenne utilisation ordinateur et écran par défaut: fichier . appareil . moyenne utilisation ordinateur et écran
    moyenne utilisation ordinateur portable par défaut: fichier . appareil . moyenne utilisation ordinateur portable
    moyenne utilisation tablette par défaut: fichier . appareil . moyenne utilisation tablette
    moyenne utilisation smartphone par défaut: fichier . appareil . moyenne utilisation smartphone
  unité: gCO2e

fichier . transmission:
  valeur: transmission par défaut
  contexte:
    transmission par défaut . taille par défaut: fichier . taille
    transmission par défaut . réseau par défaut: fichier . réseau
  unité: gCO2e

fichier . data center:
  valeur: data center par défaut
  contexte:
    data center par défaut . taille par défaut: fichier . taille
  unité: gCO2e
